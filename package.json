{
  "name": "ag-connect",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply agconnect-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply agconnect-db --remote",
    "db:seed": "tsx db/seed.ts",
    "db:seed:local": "pnpm db:seed && wrangler d1 execute agconnect-db --local --file=./db/seed.sql",
    "db:seed:remote": "pnpm db:seed && wrangler d1 execute agconnect-db --remote --file=./db/seed.sql",
    "brands:sample-colors": "tsx scripts/sample-brand-colors.ts"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "bcryptjs": "3.0.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "0.468.0",
    "next": "16.2.11",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-easy-crop": "^6.2.3",
    "react-hook-form": "7.62.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prettier": "3.6.2",
    "prisma": "6.16.2",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wrangler": "^4.115.0"
  },
  "packageManager": "pnpm@10.18.3"
}
