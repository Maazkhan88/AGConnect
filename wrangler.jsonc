{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agconnect",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Provision once with your own Cloudflare login, then paste the returned id below:
  //   npx wrangler d1 create agconnect-db
  //   npx wrangler d1 migrations apply agconnect-db --remote
  //   npx wrangler d1 execute agconnect-db --remote --file=./db/seed.sql
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agconnect-db",
      "database_id": "3523e9bf-cd29-4163-bb86-0fc956e94072",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": { "enabled": true },
  // Works around a known opennextjs-cloudflare + pnpm bug where Next.js's
  // getMiddlewareManifest() does a dynamic require() of middleware-manifest.json,
  // which workerd can't resolve (github.com/opennextjs/opennextjs-cloudflare#922).
  // NEXT_PRIVATE_MINIMAL_MODE skips that code path.
  "vars": {
    "NEXT_PRIVATE_MINIMAL_MODE": "1"
  }
}
