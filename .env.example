# Current stack: Cloudflare D1 + Drizzle + OpenNext-on-Workers (see DEPLOYMENT.md).
# AUTH_SECRET signs the admin session cookie — set it via `wrangler secret put AUTH_SECRET`
# in production; this local value is a dev-only fallback used by `next dev`.
AUTH_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"

# Used only by `pnpm db:seed` / `pnpm db:seed:remote` to create the seeded admin login.
ADMIN_EMAIL="admin@agholding.ae"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Legacy — unused by the current D1/Drizzle stack, kept only because prisma/schema.prisma
# (superseded, see DEPLOYMENT.md) still references DATABASE_URL.
DATABASE_URL="postgresql://agconnect:agconnect@localhost:5432/agconnect?schema=public"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="ag-connect"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="replace-in-production"
